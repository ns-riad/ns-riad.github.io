@unpublished{shakib2025trb,
  title        = {String Stability Assessment of Followerstopper as a Wave-Dampening Controller for Mixed-Autonomy},
  author       = {Shakib, Md Nazmus and Uddin, Shihab and Bhadani, Rahul},
  year         = {2025},
  note         = {Submitted to TRB Annual Meeting 2025},
  abstract     = {This study evaluates the string stability of the Followerstopper controller, a known wave-dampening adaptive cruise control algorithm, in an eight-vehicle platoon scenario. An eight-vehicle platoon (one human-driven leader and seven automated followers) is simulated using a real-world leader speed profile, implemented in both a microscopic traffic simulator SUMO and a high-fidelity physics-engine simulator CARLA. We employ a time-domain evaluation framework with metrics such as head-to-tail velocity amplification, L2-norm disturbance attenuation, relative speed differences, and spacing error. Results show that the Followerstopper controller nearly eliminates disturbance amplification: the head-to-tail amplification factor is approximately $0.994$ in both SUMO and CARLA, indicating slight attenuation of the leader’s perturbations. The disturbance "energy" (quantified via the L2 norm of speed errors) decreases downstream, and once the Followerstopper is activated, large relative speed oscillations and spacing deviations are rapidly damped. These improvements are consistent across both simulators, which demonstrates robust performance of Followerstopper under realistic vehicle dynamics. The proposed time-domain-based string stability assessment in realistic mixed-autonomy settings indicates that Followerstopper effectively stabilizes traffic flow by dissipating disturbances in platoon formation.},
  bibtex_show  = {true},
  abbr         = {TRB},
  html         = {https://www.trb.org/}
}

@inproceedings{shakib2025informs,
  title        = {Learning-Based CPU Burst Prediction for Efficient Scheduling in Operating Systems},
  author       = {Shakib, Md Nazmus and Bhadani, Rahul},
  booktitle    = {INFORMS Annual Meeting},
  year         = {2025},
  note         = {Poster accepted},
  abstract     = {In high-performance computing environments, scheduling decisions rely heavily on estimating how long a process will occupy the CPU. Conventional estimation techniques often fall short under varying workloads, limiting their effectiveness in modern, multi-user systems. This work introduces a data-driven framework that uses machine learning to predict process burst times using only features known at submission time. We evaluate several machine learning models, including decision trees, random forests, and multi-layer perceptrons, using real-world scheduling traces. Among them, the decision tree model offers the best trade-off between accuracy and speed. It achieves a mean absolute error (MAE) of 3514.09 and relative absolute error (RAE) of 12.64\%, which is significantly lower than the exponential averaging baseline (MAE: 14833 ms, RAE: 53.34\%), while keeping inference time per sample around 0.0033 milliseconds, making it suitable for real-time scheduling. Compared to exponential averaging, the learning-based models provide improved accuracy across a variety of workload conditions. The early availability of accurate predictions allows schedulers to make better decisions without introducing significant delay. This helps reduce wait times and improves overall CPU utilization. The study also includes model tuning and performance validation using 95\% confidence intervals to ensure the results are consistent and reliable. By introducing a fast and accurate prediction method, this work supports efficient CPU scheduling strategies that respond well to real-world system demands.},
  bibtex_show  = {true},
  abbr         = {INFORMS},
  html         = {https://meetings.informs.org/wordpress/annual2025/},
  preview      = {informs_placeholder.jpg}
}


