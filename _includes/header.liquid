{% comment %}
  SITE OVERRIDE of al_folio_core/_includes/header.liquid
  Changes: (1) dropdown children honour `section:` toggles, (2) icon-only search button (magnifying glass only; the ⌘K / Ctrl+K shortcut still works).
{% endcomment %}
<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% if page.permalink != '/' %}
        <a class="navbar-brand title font-weight-lighter" href="{{ site.baseurl }}/">
          {% if site.title == 'blank' %}
            {% if site.first_name %}
              <span class="font-weight-bold">
                {{- site.first_name -}}
              </span>
            {% endif %}
            {% if site.middle_name %}
              {{- site.middle_name -}}
            {% endif %}
            {% if site.last_name %}
              {{- site.last_name -}}
            {% endif %}
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
      {% elsif site.enable_navbar_social %}
        <!-- Social Icons -->
        <div class="navbar-brand social">{% social_links %}</div>
      {% endif %}
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed navbar-toggler-main"
        type="button"
        data-nav-toggle="navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse navbar-collapse-main" id="navbarNav">
        <ul class="navbar-nav navbar-menu-list flex-nowrap">
          {% for page in site.pages %}
            {% if page.permalink == '/' %} {% assign about_title = page.title %} {% endif %}
          {% endfor %}

          <!-- About -->
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/' | relative_url }}">
              {{- about_title }}
              {% if page.permalink == '/' %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-nav-dropdown-toggle="true"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% comment %} site override: hide children whose section is switched off in _config.yml {% endcomment %}
                      {% if child.section and site.sections[child.section] == false %}{% continue %}{% endif %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                  {%- if p.permalink contains '://' -%}
                    {%- assign url = p.permalink -%}
                  {%- elsif p.permalink contains '/blog/' -%}
                    {%- assign url = '/blog/' -%}
                  {%- else -%}
                    {%- assign url = p.url -%}
                  {%- endif %}
                  <a class="nav-link" href="{{ url | relative_url }}">
                    {{- p.title }}
                    {% if page.url contains p.url %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" type="button" title="Search" aria-label="Open search">
                {% comment %} not `.nav-link`: al_search's shortcut-key.js rewrites that span to "⌘ k 🔍" on Macs {% endcomment %}
                <span class="search-icon"><i class="fa-solid fa-magnifying-glass"></i></span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" type="button" title="Change theme" aria-label="Change color theme">
                <i class="fa-half-sun-moon" id="light-toggle-system"></i>
                <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
                <i class="fa-solid fa-sun" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
  <script>
    // Research/selected papers: show the bib `note` ("Submitted", …) as a tag next to the venue
    // instead of on its own line. Style: _sass/_custom.scss → "status tag".
    document.addEventListener("DOMContentLoaded", function () {
      document.querySelectorAll(".publications .periodical + .periodical").forEach(function (n) {
        var t = n.textContent.trim();
        n.classList.add("is-note-empty");
        if (!t) return;
        var tag = document.createElement("span");
        tag.className = "pub-note";
        tag.textContent = t;
        n.previousElementSibling.appendChild(tag);
      });
    });
  </script>
  {% comment %}
    Site motion (OUR addition): content blocks fade up as they scroll into view.
    Which blocks: the selector list below. Speed/distance: _sass/_custom.scss → "MOTION".
    Turn off everywhere: set `motion: false` in _config.yml.
  {% endcomment %}
  {% unless site.motion == false %}
    <script>
      (function () {
        var d = document.documentElement;
        if (!("IntersectionObserver" in window) || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        d.classList.add("motion");
        setTimeout(function () { d.classList.add("motion-ready"); }, 900); // never keep the page hidden
        var SEL = [
          ".post-header", ".reveal", ".hero-rule",
          ".publications h2.bibliography", "ol.bibliography > li",
          ".projects h2.category", ".projects .row > .col",
          ".tl-item", ".terms-head", ".sem-nav",
          ".award-row", ".cert-card", ".cert-text", ".awards h2", ".awards h3",
          ".cvx-head", ".cvx-title", ".cvx-entry", ".cvx-oneline", ".cvx-pubs > li", ".cvx-text",
          ".news tr", ".post-list > li", ".video-card", ".poem-list > li",
          ".post > article > h2", ".post > article > p", ".post > article > ul", ".post > article > figure",
          ".post .post-content > *"
        ].join(",");
        var SKIP = ".desk, .sem-panels, .photo-page, .home .hero-interests, .rv-off";
        document.addEventListener("DOMContentLoaded", function () {
          var main = document.querySelector("[role=main]");
          if (!main) return d.classList.add("motion-ready");
          var els = [].filter.call(main.querySelectorAll(SEL), function (el) {
            return !el.closest(SKIP) && !(el.parentElement && el.parentElement.closest(".rv"));
          });
          var io = new IntersectionObserver(function (entries) {
            var n = 0; // stagger blocks that appear together
            entries.forEach(function (e) {
              if (!e.isIntersecting) return;
              var el = e.target;
              io.unobserve(el);
              el.style.setProperty("--rv-delay", Math.min(n++ * 70, 350) + "ms");
              el.classList.add("is-in");
              el.addEventListener("animationend", function () {
                el.classList.remove("rv", "is-in");
                el.style.removeProperty("--rv-delay");
              }, { once: true });
            });
          }, { threshold: 0.06, rootMargin: "0px 0px -6% 0px" });
          els.forEach(function (el) { el.classList.add("rv"); io.observe(el); });
          d.classList.add("motion-ready");
          window.addEventListener("beforeprint", function () { d.classList.remove("motion"); });
        });
      })();
    </script>
  {% endunless %}
</header>
