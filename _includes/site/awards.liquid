{% assign a = site.data.awards %}
{% assign files = site.data.certificate_files %}

{% comment %} ---------- Honors: compact list ---------- {% endcomment %}
<h2 class="section-title">Honors &amp; awards</h2>
<ul class="award-list">
  {% for h in a.honors %}
    <li class="award-row reveal">
      <div class="award-year">{{ h.year }}</div>
      <div class="award-body">
        <h3>{{ h.title }}</h3>
        <p class="muted">{{ h.issuer }}</p>
        {% if h.description %}<p class="award-desc">{{ h.description }}</p>{% endif %}
        {% assign cf = files | where: 'key', h.certificate | first %}
        {% if cf %}
          <div class="award-actions">
            <button
              class="link-btn"
              type="button"
              data-cert-img="{{ cf.thumb | default: cf.file | relative_url }}"
              {% if cf.pdf %}data-cert-pdf="{{ cf.file | relative_url }}"{% endif %}
              data-cert-title="{{ h.title | escape }}"
            >
              <i class="fa-regular fa-image"></i> View certificate
            </button>
            {% for x in h.extra %}
              {% assign xf = files | where: 'key', x.certificate | first %}
              {% if xf %}
                <button
                  class="link-btn"
                  type="button"
                  data-cert-img="{{ xf.thumb | default: xf.file | relative_url }}"
                  {% if xf.pdf %}data-cert-pdf="{{ xf.file | relative_url }}"{% endif %}
                  data-cert-title="{{ h.title | escape }} ({{ x.label }})"
                >
                  {{ x.label }}
                </button>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ul>

{% comment %} ---------- Certificate gallery (auto-discovered from assets/certificates/) ---------- {% endcomment %}
{% if files.size > 0 %}
  <h2 class="section-title">Certificates</h2>
  {% assign cats = site.data.certificate_categories %}
  {% if cats.size > 1 %}
    <div class="seg-wrap">
    {% comment %} phones: this button opens the list of groups (a dropdown); desktop hides it {% endcomment %}
    <button class="seg-toggle" type="button" aria-expanded="false" aria-controls="cert-tabs">
      <span class="seg-toggle-label">All</span> <span class="chip-count seg-toggle-count">{{ files.size }}</span>
      <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
    </button>
    <div class="filter-chips seg-tabs" id="cert-tabs" role="group" aria-label="Filter certificates">
      <span class="seg-indicator" aria-hidden="true"></span>
      <button class="chip chip-btn is-active" type="button" data-filter="all">All <span class="chip-count">{{ files.size }}</span></button>
      {% for c in cats %}
        {% assign n = files | where: 'category', c.key | size %}
        <button class="chip chip-btn" type="button" data-filter="{{ c.key }}">{{ c.label }} <span class="chip-count">{{ n }}</span></button>
      {% endfor %}
    </div>
    </div>
  {% endif %}
  <div class="cert-grid">
    {% for c in files %}
      <figure class="cert-card reveal" data-tag="{{ c.category }}">
        <button
          type="button"
          class="cert-thumb"
          data-cert-img="{{ c.thumb | default: c.file | relative_url }}"
          {% if c.pdf %}data-cert-pdf="{{ c.file | relative_url }}"{% endif %}
          data-cert-title="{{ c.title | escape }}"
          aria-label="View {{ c.title | escape }}"
        >
          {% if c.thumb or c.pdf == false %}
            <img src="{{ c.thumb | default: c.file | relative_url }}" alt="{{ c.title | escape }}" loading="lazy">
          {% else %}
            <span class="cert-placeholder"><i class="fa-regular fa-file-pdf"></i></span>
          {% endif %}
        </button>
        <figcaption>
          <strong>{{ c.title }}</strong>
          <span class="muted small">
            {{- c.issuer -}}
            {%- if c.issuer and c.date_label %} · {% endif -%}
            {{- c.date_label -}}
          </span>
          {% if c.verify %}<a class="small" href="{{ c.verify }}">Verify <i class="fa-solid fa-arrow-up-right-from-square"></i></a>{% endif %}
        </figcaption>
      </figure>
    {% endfor %}
  </div>
{% endif %}

{% comment %} ---------- Listed in _data/certificates.yml but no file yet ---------- {% endcomment %}
{% assign text_only = site.data.certificate_text_only %}
{% if text_only.size > 0 and site.data.certificates.show_also_completed != false %}
  <h2 class="section-title">Also completed</h2>
  <ul class="cert-text-list">
    {% for c in text_only %}
      <li>
        <span><strong>{{ c.title }}</strong>{% if c.issuer %} <span class="muted">· {{ c.issuer }}</span>{% endif %}</span>
        <span class="muted small">
          {{- c.date_label -}}
          {%- if c.verify %} <a href="{{ c.verify }}">verify</a>{% endif -%}
        </span>
      </li>
    {% endfor %}
  </ul>
{% endif %}

{% include site/lightbox.liquid %}

<script>
  // Certificate groups. Desktop: a highlight slides to the chosen tab. Phones: the same tabs form a dropdown list.
  // Switching: the current cards fade out, then the chosen group fades up one card after another.
  (function () {
    var wrap = document.querySelector(".seg-wrap");
    if (!wrap) return;
    var bar = wrap.querySelector(".seg-tabs");
    var tabs = bar.querySelectorAll(".chip-btn");
    var ind = bar.querySelector(".seg-indicator");
    var toggle = wrap.querySelector(".seg-toggle");
    var cards = document.querySelectorAll(".cert-card");
    var grid = document.querySelector(".cert-grid");
    var reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    var OUT = 200; // ms for the fade-out
    var busy = null;

    function place(tab, instant) {
      if (!tab.offsetWidth) return; // hidden (phone dropdown closed)
      if (instant) ind.style.transition = "none";
      ind.style.width = tab.offsetWidth + "px";
      ind.style.height = tab.offsetHeight + "px";
      ind.style.transform = "translate(" + tab.offsetLeft + "px," + tab.offsetTop + "px)";
      if (instant) { ind.offsetWidth; ind.style.transition = ""; }
    }
    function current() { return bar.querySelector(".chip-btn.is-active") || tabs[0]; }
    function setOpen(open) {
      wrap.classList.toggle("is-open", open);
      toggle.setAttribute("aria-expanded", open);
      if (open) requestAnimationFrame(function () { place(current(), true); });
    }
    function showGroup(f) {
      var n = 0;
      cards.forEach(function (card) {
        card.classList.remove("cert-out", "cert-in");
        var show = f === "all" || card.dataset.tag === f;
        card.hidden = !show;
        if (show && !reduce) {
          card.style.setProperty("--d", Math.min(n++ * 45, 500) + "ms");
          card.offsetWidth; // restart the animation
          card.classList.add("cert-in");
        }
      });
      grid.style.minHeight = "";
    }
    function filter(f) {
      // cards are taken over by the tab animation: drop the page's scroll-reveal so it can't replay later
      cards.forEach(function (c) { c.classList.remove("rv", "is-in", "reveal"); c.style.removeProperty("--rv-delay"); });
      if (reduce) return showGroup(f);
      clearTimeout(busy);
      grid.style.minHeight = grid.offsetHeight + "px"; // no page jump while swapping
      cards.forEach(function (card) { if (!card.hidden) { card.classList.remove("cert-in"); card.classList.add("cert-out"); } });
      busy = setTimeout(function () { showGroup(f); }, OUT);
    }

    toggle.addEventListener("click", function () { setOpen(!wrap.classList.contains("is-open")); });
    document.addEventListener("click", function (e) { if (!wrap.contains(e.target)) setOpen(false); });
    tabs.forEach(function (tab) {
      tab.setAttribute("aria-pressed", tab.classList.contains("is-active"));
      tab.addEventListener("click", function () {
        if (tab.classList.contains("is-active")) return setOpen(false);
        tabs.forEach(function (t) { t.classList.remove("is-active"); t.setAttribute("aria-pressed", "false"); });
        tab.classList.add("is-active");
        tab.setAttribute("aria-pressed", "true");
        place(tab);
        toggle.querySelector(".seg-toggle-label").textContent = tab.firstChild.textContent.trim();
        toggle.querySelector(".seg-toggle-count").textContent = tab.querySelector(".chip-count").textContent;
        setTimeout(function () { setOpen(false); }, reduce ? 0 : 220); // let the highlight land first
        filter(tab.dataset.filter);
      });
    });
    place(current(), true);
    addEventListener("resize", function () { place(current(), true); });
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(function () { place(current(), true); });
  })();
</script>
