{% comment %}
  In-browser MNIST demo. Loads the project's own model file (assets/demos/mnist/mnist_cnn.onnx, copied from
  github.com/nsriad/MNIST-Flask-App), reads its weights directly from the ONNX file and runs the network
  (Conv-ReLU-Pool ×2, Dense-ReLU, Dense) in plain JavaScript: no library, no WebAssembly, nothing sent to a server.
  Input: draw (mouse / touch), upload an image, or pick an MNIST sample.
  Preprocessing mirrors MNIST: white digit on black, cropped, scaled to 20 px, centred by mass in 28×28.
  Style: _sass/_custom.scss → "MNIST DEMO".
{% endcomment %}
{% assign base = '/assets/demos/mnist/' | relative_url %}
<div class="mn-demo" data-model="{{ base }}mnist_cnn.onnx">
  <div class="mn-panel mn-input">
    <div class="mn-tabs" role="tablist">
      <button type="button" class="is-on" data-mode="draw" role="tab"><i class="fa-solid fa-pen"></i> Draw</button>
      <button type="button" data-mode="upload" role="tab"><i class="fa-solid fa-upload"></i> Upload</button>
    </div>
    <div class="mn-stage">
      <canvas class="mn-canvas" width="280" height="280" aria-label="Drawing area: draw a digit"></canvas>
      <span class="mn-hint">Draw a digit (0–9)</span>
      <label class="mn-drop" hidden>
        <input type="file" accept="image/*" hidden>
        <i class="fa-solid fa-image"></i>
        <span>Choose or drop an image</span>
        <small>a single digit; any background</small>
      </label>
    </div>
    <div class="mn-row">
      <button type="button" class="mn-btn mn-clear"><i class="fa-solid fa-eraser"></i> Clear</button>
      <span class="mn-status">Loading model…</span>
    </div>
    <div class="mn-samples">
      <span class="mn-label">Or try an MNIST sample</span>
      <div class="mn-sample-row">
        {% for k in (0..9) %}<button type="button" class="mn-sample" data-src="{{ base }}samples/{{ k }}.png" aria-label="Sample digit {{ k }}"><img src="{{ base }}samples/{{ k }}.png" alt="" width="28" height="28"></button>{% endfor %}
      </div>
    </div>
  </div>

  <div class="mn-panel mn-output" aria-live="polite">
    <div class="mn-top">
      <div>
        <span class="mn-label">Prediction</span>
        <div class="mn-digit">–</div>
        <div class="mn-conf">&nbsp;</div>
      </div>
      <div class="mn-seen">
        <span class="mn-label">Model input</span>
        <canvas class="mn-mini" width="28" height="28"></canvas>
        <small>28 × 28</small>
      </div>
    </div>
    <div class="mn-bars">
      {% for k in (0..9) %}
        <div class="mn-bar" data-k="{{ k }}">
          <span class="mn-k">{{ k }}</span>
          <span class="mn-track"><span class="mn-fill"></span></span>
          <span class="mn-pct">0%</span>
        </div>
      {% endfor %}
    </div>
    <p class="mn-foot"><i class="fa-solid fa-lock"></i> Runs entirely in your browser from the project's ONNX file. Nothing is uploaded.</p>
  </div>
</div>

<script>
(function () {
  var root = document.querySelector(".mn-demo");
  if (!root) return;
  var cv = root.querySelector(".mn-canvas"), ctx = cv.getContext("2d");
  var mini = root.querySelector(".mn-mini"), mctx = mini.getContext("2d");
  var hint = root.querySelector(".mn-hint"), drop = root.querySelector(".mn-drop"), file = drop.querySelector("input");
  var status = root.querySelector(".mn-status"), out = root.querySelector(".mn-digit"), conf = root.querySelector(".mn-conf");
  var bars = [].slice.call(root.querySelectorAll(".mn-bar"));
  var session = null, loading = null, timer = null;

  function blank() { ctx.fillStyle = "#000"; ctx.fillRect(0, 0, 280, 280); }
  blank();

  // ---- read the ONNX file: a tiny protobuf reader for the graph's ops and weight tensors ----
  function readONNX(buf) {
    var u = new Uint8Array(buf);
    function fields(s, e, cb) {
      var i = s;
      while (i < e) {
        var key = 0, sh = 0, c;
        do { c = u[i++]; key += (c & 127) * Math.pow(2, sh); sh += 7; } while (c > 127);
        var f = Math.floor(key / 8), t = key % 8, v = 0;
        if (t === 0) { sh = 0; do { c = u[i++]; v += (c & 127) * Math.pow(2, sh); sh += 7; } while (c > 127); cb(f, t, v); }
        else if (t === 2) { var n = 0; sh = 0; do { c = u[i++]; n += (c & 127) * Math.pow(2, sh); sh += 7; } while (c > 127); cb(f, t, i, i + n); i += n; }
        else if (t === 5) { i += 4; } else if (t === 1) { i += 8; } else throw new Error("bad wire type");
      }
    }
    var txt = new TextDecoder(), ops = [], W = {};
    fields(0, u.length, function (f, t, s, e) {
      if (f !== 7 || t !== 2) return; // ModelProto.graph
      fields(s, e, function (g, t2, s2, e2) {
        if (t2 !== 2) return;
        if (g === 1) fields(s2, e2, function (h, t3, a, b) { if (h === 4 && t3 === 2) ops.push(txt.decode(u.subarray(a, b))); }); // NodeProto.op_type
        if (g === 5) { // TensorProto (initializer)
          var name = "", raw = null;
          fields(s2, e2, function (h, t3, a, b) {
            if (h === 8 && t3 === 2) name = txt.decode(u.subarray(a, b));
            if (h === 9 && t3 === 2) raw = buf.slice(a, b);
          });
          if (raw) W[name] = new Float32Array(raw);
        }
      });
    });
    var want = "Conv,Relu,MaxPool,Conv,Relu,MaxPool,Flatten,Gemm,Relu,Gemm";
    if (ops.join() !== want) throw new Error("unexpected graph: " + ops.join());
    return W;
  }

  // ---- forward pass (NCHW, same maths as the ONNX graph) ----
  function conv(x, C, H, w, b, K) { // 3×3, stride 1, no padding, + ReLU
    var Ho = H - 2, o = new Float32Array(K * Ho * Ho);
    for (var k = 0; k < K; k++) for (var i = 0; i < Ho; i++) for (var j = 0; j < Ho; j++) {
      var s = b[k];
      for (var c = 0; c < C; c++) {
        var wo = (k * C + c) * 9, xo = c * H * H + i * H + j;
        s += w[wo] * x[xo] + w[wo + 1] * x[xo + 1] + w[wo + 2] * x[xo + 2]
           + w[wo + 3] * x[xo + H] + w[wo + 4] * x[xo + H + 1] + w[wo + 5] * x[xo + H + 2]
           + w[wo + 6] * x[xo + 2 * H] + w[wo + 7] * x[xo + 2 * H + 1] + w[wo + 8] * x[xo + 2 * H + 2];
      }
      o[k * Ho * Ho + i * Ho + j] = s > 0 ? s : 0;
    }
    return o;
  }
  function pool(x, C, H) { // 2×2 max, stride 2 (floor)
    var Ho = Math.floor(H / 2), o = new Float32Array(C * Ho * Ho);
    for (var c = 0; c < C; c++) for (var i = 0; i < Ho; i++) for (var j = 0; j < Ho; j++) {
      var p = c * H * H + 2 * i * H + 2 * j;
      o[c * Ho * Ho + i * Ho + j] = Math.max(x[p], x[p + 1], x[p + H], x[p + H + 1]);
    }
    return o;
  }
  function dense(x, w, b, relu) { // Gemm with transB = 1: y = x·Wᵀ + b
    var n = b.length, m = x.length, o = new Float32Array(n);
    for (var k = 0; k < n; k++) { var s = b[k], r = k * m; for (var i = 0; i < m; i++) s += w[r + i] * x[i]; o[k] = relu && s < 0 ? 0 : s; }
    return o;
  }
  function forward(W, x) {
    var a = pool(conv(x, 1, 28, W["conv1.weight"], W["conv1.bias"], 32), 32, 26);   // 32×13×13
    a = pool(conv(a, 32, 13, W["conv2.weight"], W["conv2.bias"], 64), 64, 11);      // 64×5×5
    a = dense(a, W["fc1.weight"], W["fc1.bias"], true);                              // 128
    return dense(a, W["fc2.weight"], W["fc2.bias"], false);                          // 10 logits
  }

  function load() {
    if (loading) return loading;
    loading = fetch(root.dataset.model)
      .then(function (r) { if (!r.ok) throw new Error(r.status); return r.arrayBuffer(); })
      .then(function (buf) {
        session = readONNX(buf);
        status.textContent = "Model ready";
        root.classList.add("is-ready");
      })
      .catch(function (e) { status.textContent = "Couldn't load the model"; console.error(e); });
    return loading;
  }
  if ("IntersectionObserver" in window) {
    var io = new IntersectionObserver(function (es) { if (es[0].isIntersecting) { io.disconnect(); load(); } }, { rootMargin: "300px" });
    io.observe(root);
  } else load();

  // ---- MNIST-style preprocessing: any source → white-on-black 28×28 Float32 ----
  function toTensor(src, sw, sh, isDrawing, inner) {
    var W = 140, H = 140, k = Math.min(W / sw, H / sh);
    var w = Math.max(1, Math.round(sw * k)), h = Math.max(1, Math.round(sh * k));
    var a = document.createElement("canvas"); a.width = w; a.height = h;
    var ac = a.getContext("2d"); ac.drawImage(src, 0, 0, w, h);
    var px = ac.getImageData(0, 0, w, h), d = px.data, g = new Float32Array(w * h), i, x, y;
    for (i = 0; i < w * h; i++) {
      var al = d[i * 4 + 3] / 255; // transparent pixels count as background
      var lum = (0.299 * d[i * 4] + 0.587 * d[i * 4 + 1] + 0.114 * d[i * 4 + 2]) / 255;
      g[i] = isDrawing ? lum : lum * al + (1 - al);
    }
    if (!isDrawing) {
      // light background (border mostly bright) → invert so the digit is white on black, like MNIST
      var sum = 0, cnt = 0;
      for (x = 0; x < w; x++) { sum += g[x] + g[(h - 1) * w + x]; cnt += 2; }
      for (y = 0; y < h; y++) { sum += g[y * w] + g[y * w + w - 1]; cnt += 2; }
      if (sum / cnt > 0.5) for (i = 0; i < g.length; i++) g[i] = 1 - g[i];
      // stretch contrast: darkest → 0, brightest → 1
      var lo = 1, hi = 0;
      for (i = 0; i < g.length; i++) { if (g[i] < lo) lo = g[i]; if (g[i] > hi) hi = g[i]; }
      for (i = 0; i < g.length; i++) g[i] = hi > lo ? Math.max(0, (g[i] - lo) / (hi - lo) - 0.15) / 0.85 : 0;
    }
    // a framed picture (e.g. a plot of an MNIST digit: dark square on a white page) shows up as a huge
    // block of "ink"; find the rows/columns that are mostly ink and look inside that frame instead
    if (!isDrawing && !inner) {
      var ink = 0;
      for (i = 0; i < g.length; i++) if (g[i] > 0.5) ink++;
      if (ink / g.length > 0.3) {
        var r0 = -1, r1 = -1, c0 = -1, c1 = -1, n;
        for (y = 0; y < h; y++) { n = 0; for (x = 0; x < w; x++) if (g[y * w + x] > 0.5) n++; if (n > 0.45 * w) { if (r0 < 0) r0 = y; r1 = y; } }
        for (x = 0; x < w; x++) { n = 0; for (y = 0; y < h; y++) if (g[y * w + x] > 0.5) n++; if (n > 0.45 * h) { if (c0 < 0) c0 = x; c1 = x; } }
        if (r0 >= 0 && c0 >= 0 && r1 - r0 > 10 && c1 - c0 > 10) {
          var fx = Math.floor((c0 + 2) / k), fy = Math.floor((r0 + 2) / k), fw = Math.floor((c1 - c0 - 4) / k), fh = Math.floor((r1 - r0 - 4) / k);
          var f = document.createElement("canvas"); f.width = fw; f.height = fh;
          f.getContext("2d").drawImage(src, fx, fy, fw, fh, 0, 0, fw, fh);
          var t2 = toTensor(f, fw, fh, false, true);
          if (t2) return t2;
        }
      }
    }
    // bounding box of the ink
    var x0 = w, y0 = h, x1 = -1, y1 = -1;
    for (y = 0; y < h; y++) for (x = 0; x < w; x++) if (g[y * w + x] > 0.2) {
      if (x < x0) x0 = x; if (x > x1) x1 = x; if (y < y0) y0 = y; if (y > y1) y1 = y;
    }
    if (x1 < 0) return null;
    for (i = 0; i < g.length; i++) { var v = Math.round(g[i] * 255); d[i * 4] = d[i * 4 + 1] = d[i * 4 + 2] = v; d[i * 4 + 3] = 255; }
    ac.putImageData(px, 0, 0);
    // fit the digit into a 20×20 box, then centre it by mass in 28×28
    var bw = x1 - x0 + 1, bh = y1 - y0 + 1, s = 20 / Math.max(bw, bh);
    var dw = bw * s, dh = bh * s;
    function render(ox, oy) {
      mctx.fillStyle = "#000"; mctx.fillRect(0, 0, 28, 28);
      mctx.imageSmoothingEnabled = true; mctx.imageSmoothingQuality = "high";
      mctx.drawImage(a, x0, y0, bw, bh, ox, oy, dw, dh);
      return mctx.getImageData(0, 0, 28, 28).data;
    }
    var ox = (28 - dw) / 2, oy = (28 - dh) / 2, m = render(ox, oy), mx = 0, my = 0, ms = 0;
    for (i = 0; i < 784; i++) { var p = m[i * 4]; ms += p; mx += (i % 28) * p; my += Math.floor(i / 28) * p; }
    if (ms > 0) {
      var sx = Math.max(-4, Math.min(4, 13.5 - mx / ms)), sy = Math.max(-4, Math.min(4, 13.5 - my / ms));
      m = render(ox + sx, oy + sy);
    }
    var t = new Float32Array(784);
    for (i = 0; i < 784; i++) t[i] = m[i * 4] / 255;
    return t;
  }

  function show(probs) {
    var best = 0;
    for (var k = 1; k < 10; k++) if (probs[k] > probs[best]) best = k;
    out.textContent = best;
    out.classList.remove("is-pop"); void out.offsetWidth; out.classList.add("is-pop");
    conf.textContent = (probs[best] * 100).toFixed(1) + "% confident";
    bars.forEach(function (b, k) {
      b.classList.toggle("is-best", k === best);
      b.querySelector(".mn-fill").style.width = (probs[k] * 100).toFixed(1) + "%";
      b.querySelector(".mn-pct").textContent = (probs[k] * 100 < 0.1 && probs[k] > 0 ? "<0.1" : (probs[k] * 100).toFixed(1)) + "%";
    });
  }
  function reset() {
    out.textContent = "–"; conf.innerHTML = "&nbsp;";
    mctx.fillStyle = "#000"; mctx.fillRect(0, 0, 28, 28);
    bars.forEach(function (b) { b.classList.remove("is-best"); b.querySelector(".mn-fill").style.width = "0"; b.querySelector(".mn-pct").textContent = "0%"; });
  }
  reset();

  function predict(src, sw, sh, isDrawing) {
    var t = toTensor(src, sw, sh, isDrawing);
    if (!t) { reset(); return; }
    load().then(function () {
      if (!session) return;
      var z = forward(session, t), mx = Math.max.apply(null, z), e = [], sum = 0;
      for (var k = 0; k < 10; k++) { e[k] = Math.exp(z[k] - mx); sum += e[k]; }
      show(e.map(function (v) { return v / sum; }));
    });
  }

  // ---- drawing (mouse, pen, touch) ----
  var drawing = false, last = null;
  function pos(e) { var r = cv.getBoundingClientRect(); return [(e.clientX - r.left) * 280 / r.width, (e.clientY - r.top) * 280 / r.height]; }
  cv.addEventListener("pointerdown", function (e) {
    drawing = true; last = pos(e); cv.setPointerCapture(e.pointerId); hint.hidden = true;
    ctx.fillStyle = "#fff"; ctx.beginPath(); ctx.arc(last[0], last[1], 9, 0, 7); ctx.fill();
  });
  cv.addEventListener("pointermove", function (e) {
    if (!drawing) return;
    var p = pos(e);
    ctx.strokeStyle = "#fff"; ctx.lineWidth = 18; ctx.lineCap = "round"; ctx.lineJoin = "round";
    ctx.beginPath(); ctx.moveTo(last[0], last[1]); ctx.lineTo(p[0], p[1]); ctx.stroke();
    last = p;
    clearTimeout(timer); timer = setTimeout(function () { predict(cv, 280, 280, true); }, 120); // live while drawing
  });
  ["pointerup", "pointercancel"].forEach(function (ev) {
    cv.addEventListener(ev, function () { if (drawing) { drawing = false; predict(cv, 280, 280, true); } });
  });

  // ---- upload / samples ----
  function useImage(url) {
    var img = new Image();
    img.onload = function () {
      blank(); hint.hidden = true;
      var k = Math.min(280 / img.width, 280 / img.height), w = img.width * k, h = img.height * k;
      ctx.imageSmoothingEnabled = img.width > 64;
      ctx.drawImage(img, (280 - w) / 2, (280 - h) / 2, w, h);
      ctx.imageSmoothingEnabled = true;
      setMode("draw", true);
      predict(img, img.width, img.height, false);
    };
    img.src = url;
  }
  // read files as data: URLs (the site's security policy allows data: images, not blob:)
  function useFile(f) {
    if (!f || f.type.indexOf("image/") !== 0) return;
    var rd = new FileReader();
    rd.onload = function () { useImage(rd.result); };
    rd.readAsDataURL(f);
  }
  file.addEventListener("change", function () { useFile(file.files[0]); file.value = ""; });
  drop.addEventListener("dragover", function (e) { e.preventDefault(); drop.classList.add("is-over"); });
  drop.addEventListener("dragleave", function () { drop.classList.remove("is-over"); });
  drop.addEventListener("drop", function (e) {
    e.preventDefault(); drop.classList.remove("is-over");
    useFile(e.dataTransfer.files[0]);
  });
  root.querySelectorAll(".mn-sample").forEach(function (b) {
    b.addEventListener("click", function () {
      root.querySelectorAll(".mn-sample").forEach(function (x) { x.classList.toggle("is-on", x === b); });
      useImage(b.dataset.src);
    });
  });

  // ---- tabs + clear ----
  function setMode(m, keep) {
    root.querySelectorAll(".mn-tabs button").forEach(function (t) { t.classList.toggle("is-on", t.dataset.mode === m); });
    drop.hidden = m !== "upload";
    if (m === "upload" && !keep) { blank(); reset(); hint.hidden = true; }
    if (m === "draw" && !keep) { hint.hidden = false; }
  }
  root.querySelectorAll(".mn-tabs button").forEach(function (t) { t.addEventListener("click", function () { setMode(t.dataset.mode); if (t.dataset.mode === "draw") { blank(); reset(); } }); });
  root.querySelector(".mn-clear").addEventListener("click", function () {
    blank(); reset(); hint.hidden = false; setMode("draw", true);
    root.querySelectorAll(".mn-sample").forEach(function (x) { x.classList.remove("is-on"); });
  });
})();
</script>
