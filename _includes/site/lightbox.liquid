{% comment %}
  Reusable lightbox. Any element with data-cert-img="<url>" (optional data-cert-pdf, data-cert-title)
  opens the image in a native <dialog>. Used by awards and photography.
{% endcomment %}
<dialog class="lightbox" id="lightbox" aria-label="Image viewer">
  <button class="lightbox-close" type="button" aria-label="Close">&times;</button>
  <img class="lightbox-img" src="" alt="">
  <div class="lightbox-bar">
    <span class="lightbox-title"></span>
    <a class="lightbox-pdf" href="#" target="_blank" rel="noopener">Open PDF <i class="fa-solid fa-arrow-up-right-from-square"></i></a>
  </div>
</dialog>
<script>
  (function () {
    var dlg = document.getElementById("lightbox");
    if (!dlg || dlg.dataset.bound) return;
    dlg.dataset.bound = "1";
    var img = dlg.querySelector(".lightbox-img"),
      title = dlg.querySelector(".lightbox-title"),
      pdf = dlg.querySelector(".lightbox-pdf");
    document.addEventListener("click", function (e) {
      var t = e.target.closest("[data-cert-img]");
      if (!t) return;
      e.preventDefault();
      img.src = t.dataset.certImg;
      img.alt = t.dataset.certTitle || "";
      title.textContent = t.dataset.certTitle || "";
      if (t.dataset.certPdf) { pdf.href = t.dataset.certPdf; pdf.hidden = false; } else { pdf.hidden = true; }
      dlg.showModal();
    });
    dlg.addEventListener("click", function (e) {
      if (e.target === dlg || e.target.classList.contains("lightbox-close")) dlg.close();
    });
  })();
</script>
