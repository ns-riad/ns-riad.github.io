{% comment %}
  "On this page" navigator for detailed project pages, built from the page's ## headings.
  Wide screens (≥1240px): a vertical timeline in the left margin, visible from the start; one labelled
  dot per section, a line that fills as you read, and a ripple on the current dot. Smaller screens: a floating rounded-square button (bottom-left)
  whose border fills as you read; tap it to open the list of sections. Style: _sass/_custom.scss → "PROJECT PAGE: navigator".
{% endcomment %}
<nav class="pjnav" aria-label="On this page" hidden>
  <div class="pjtl">
    <div class="pjtl-inner">
      <div class="pjtl-track"><span class="pjtl-fill"></span></div>
      <ol class="pjtl-list"></ol>
    </div>
  </div>
  <button class="pjnav-fab" type="button" aria-expanded="false" aria-label="Sections">
    <svg class="pjnav-ring" viewBox="0 0 50 50" aria-hidden="true">
      <rect class="bg" x="1.5" y="1.5" width="47" height="47" rx="11" pathLength="100"></rect>
      <rect class="fg" x="1.5" y="1.5" width="47" height="47" rx="11" pathLength="100"></rect>
    </svg>
    <span class="pjnav-fab-num">01</span>
    <i class="fa-solid fa-list-ul" aria-hidden="true"></i>
  </button>
  <div class="pjnav-sheet" role="dialog" aria-label="Sections">
    <div class="pjnav-head">On this page</div>
    <ol class="pjnav-list"></ol>
  </div>
</nav>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    var nav = document.querySelector(".pjnav");
    if (!nav) return;
    var heads = [].slice.call(document.querySelectorAll(".post article > h2"));
    if (!heads.length) return nav.remove();
    document.body.appendChild(nav); // fixed to the window, outside the theme's scrolling wrapper
    nav.hidden = false;
    nav.style.setProperty("--pjtl-n", heads.length);
    var fab = nav.querySelector(".pjnav-fab"), tlFill = nav.querySelector(".pjtl-fill"),
      ring = nav.querySelector(".pjnav-ring .fg"), num = nav.querySelector(".pjnav-fab-num");
    var groups = [].map.call(nav.querySelectorAll(".pjnav-list"), function (ol) {
      return heads.map(function (h, i) {
        if (!h.id) h.id = "s-" + (i + 1);
        var li = document.createElement("li"), a = document.createElement("a");
        a.href = "#" + h.id;
        a.style.setProperty("--i", i);
        a.innerHTML = '<span class="n">' + String(i + 1).padStart(2, "0") + '</span><span class="t">' + h.textContent.trim() + "</span>";
        a.addEventListener("click", function () { setOpen(false); });
        li.appendChild(a);
        ol.appendChild(li);
        return a;
      });
    });
    // desktop timeline: dots spaced evenly, each at the centre of its slot
    var n = heads.length, pos = heads.map(function (_, i) { return ((i + 0.5) / n) * 100; });
    var dots = heads.map(function (h, i) {
      var li = document.createElement("li"), a = document.createElement("a");
      li.style.top = pos[i] + "%";
      a.href = "#" + h.id;
      a.title = h.textContent.trim();
      a.innerHTML = '<span class="dot"></span><span class="lbl"><span class="n">' + String(i + 1).padStart(2, "0") + "</span>" + h.textContent.trim() + "</span>";
      li.appendChild(a);
      nav.querySelector(".pjtl-list").appendChild(li);
      return li;
    });
    var navbar = document.getElementById("navbar");

    // section links scroll to an exact spot just below the fixed bars (no stacked offsets)
    function offsetTop() {
      return (navbar ? navbar.getBoundingClientRect().bottom : 0) + 24;
    }
    function goTo(h, tries) {
      tries = tries || 0;
      var reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      scrollTo({ top: h.getBoundingClientRect().top + scrollY - offsetTop(), behavior: reduce || tries ? "auto" : "smooth" });
      if (!tries) history.replaceState(null, "", "#" + h.id);
      // figures above may finish loading during the scroll and push the section down: re-check once settled
      if (tries < 4) setTimeout(function () {
        if (Math.abs(h.getBoundingClientRect().top - offsetTop()) > 4) goTo(h, tries + 1);
      }, tries ? 250 : 700);
    }
    nav.addEventListener("click", function (e) {
      var a = e.target.closest('a[href^="#"]');
      if (!a) return;
      var h = document.getElementById(a.getAttribute("href").slice(1));
      if (!h) return;
      e.preventDefault();
      goTo(h);
    });

    function setOpen(o) { nav.classList.toggle("is-open", o); fab.setAttribute("aria-expanded", o); }
    fab.addEventListener("click", function (e) { e.stopPropagation(); setOpen(!nav.classList.contains("is-open")); });
    document.addEventListener("click", function (e) { if (!nav.contains(e.target)) setOpen(false); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape") setOpen(false); });
    var article = document.querySelector(".post article"), active = -2;
    function docTop(el) { return el.getBoundingClientRect().top + scrollY; }
    function update() {
      var line = scrollY + innerHeight * 0.3; // the reading line
      var start = docTop(article), end = start + article.offsetHeight - innerHeight * 0.6;
      var tops = heads.map(docTop), i = -1;
      tops.forEach(function (t, k) { if (t <= line) i = k; });
      var atEnd = scrollY + innerHeight >= document.documentElement.scrollHeight - 4;
      if (atEnd) i = n - 1; // the last section may never reach the reading line
      // timeline fill: interpolate between the dots of the current and next section
      var f;
      if (atEnd) f = 100;
      else if (i < 0) f = pos[0] * Math.max(0, (line - start) / (tops[0] - start));
      else {
        var a = tops[i], b = i + 1 < n ? tops[i + 1] : Math.max(end, a + 1), to = i + 1 < n ? pos[i + 1] : 100;
        f = pos[i] + (to - pos[i]) * Math.min(1, Math.max(0, (line - a) / (b - a)));
      }
      tlFill.style.transform = "scaleY(" + Math.min(f, 100) / 100 + ")";
      var p = Math.min(1, Math.max(0, (line - start) / (end - start)));
      ring.style.strokeDashoffset = 100 - p * 100;
      nav.classList.toggle("is-shown", scrollY > 280);
      if (i === active) return;
      active = i;
      dots.forEach(function (d, k) { d.classList.toggle("is-active", k === i); d.classList.toggle("is-read", k < i); });
      groups.forEach(function (g) { g.forEach(function (a, k) { a.classList.toggle("is-active", k === i); a.classList.toggle("is-read", k < i); }); });
      num.textContent = String(Math.max(i, 0) + 1).padStart(2, "0");
    }
    addEventListener("scroll", update, { passive: true });
    addEventListener("resize", update);
    update();
  });
</script>
