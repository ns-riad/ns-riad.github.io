---
layout: default
---
{% comment %} One photograph. Pages are generated by _plugins/media_library.rb from assets/photography/. {% endcomment %}
{% assign p = page.photo %}
<div class="post photo-page">
  <a class="photo-back" href="{{ '/photography/' | relative_url }}"><i class="fa-solid fa-arrow-left"></i> All photographs</a>

  <figure class="photo-hero photo-{{ p.orientation }}">
    <a href="{{ p.large | relative_url }}" target="_blank" rel="noopener" aria-label="Open full size">
      <img src="{{ p.large | relative_url }}" {% if p.width %}width="{{ p.width }}" height="{{ p.height }}"{% endif %} alt="{{ p.title | escape }}">
    </a>
  </figure>

  <header class="photo-info">
    <h1 class="post-title">{{ p.title }}</h1>
    {% if p.place or p.date != '' %}
      <p class="photo-where muted">
        {% if p.place %}<i class="fa-solid fa-location-dot"></i> {{ p.place }}{% endif %}
        {% if p.place and p.date != '' %}<span class="sep">·</span>{% endif %}
        {% if p.date != '' %}{{ p.date | date: '%B %-d, %Y' }}{% endif %}
      </p>
    {% endif %}
    {% if p.caption %}<p class="photo-caption">{{ p.caption | markdownify | remove: '<p>' | remove: '</p>' }}</p>{% endif %}
    {% if p.exif.size > 0 %}
      <p class="photo-exif">
        {% if p.exif.camera %}<span><i class="fa-solid fa-camera"></i> {{ p.exif.camera }}</span>{% endif %}
        {% if p.exif.lens %}<span>{{ p.exif.lens }}</span>{% endif %}
        {% if p.exif.focal %}<span>{{ p.exif.focal }}</span>{% endif %}
        {% if p.exif.aperture %}<span>{{ p.exif.aperture }}</span>{% endif %}
        {% if p.exif.shutter %}<span>{{ p.exif.shutter }}</span>{% endif %}
        {% if p.exif.iso %}<span>{{ p.exif.iso }}</span>{% endif %}
      </p>
    {% endif %}
    {% if p.story %}
      <a class="hero-btn hero-btn-primary" href="{{ p.story | relative_url }}"><i class="fa-solid fa-book-open"></i> {{ p.story_label | default: 'Read the story' }}</a>
    {% endif %}
  </header>

  <nav class="photo-nav" aria-label="More photographs">
    {% if page.prev_photo %}
      <a class="photo-nav-link prev" href="{{ page.prev_photo.url | relative_url }}">
        <img src="{{ page.prev_photo.thumb | relative_url }}" alt="" loading="lazy">
        <span><small class="muted">Previous</small>{{ page.prev_photo.title }}</span>
      </a>
    {% else %}<span></span>{% endif %}
    {% if page.next_photo %}
      <a class="photo-nav-link next" href="{{ page.next_photo.url | relative_url }}">
        <span><small class="muted">Next</small>{{ page.next_photo.title }}</span>
        <img src="{{ page.next_photo.thumb | relative_url }}" alt="" loading="lazy">
      </a>
    {% endif %}
  </nav>
</div>
<script>
  // ← / → to move between photos
  document.addEventListener("keydown", function (e) {
    if (e.target.closest("input, textarea")) return;
    var a = document.querySelector(".photo-nav-link." + (e.key === "ArrowLeft" ? "prev" : e.key === "ArrowRight" ? "next" : "none"));
    if (a) location.href = a.href;
  });
</script>
